# Copy this file to .env and fill in the values.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# The API builds the connection URL as:
#   postgresql://POSTGRES_USER:POSTGRES_PASSWORD@POSTGRES_HOST:POSTGRES_PORT/POSTGRES_DB
# Advanced: set DATABASE_URL directly to override all POSTGRES_* vars.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=novacode
POSTGRES_HOST=postgres        # "postgres" when using docker-compose, else your DB host
POSTGRES_PORT=5432

# ── Auth ──────────────────────────────────────────────────────────────────────
# Long random string — generate with: openssl rand -hex 32
# Required at process start (the example placeholder is rejected).
JWT_SECRET=change_this_to_a_long_random_string

# Comma-separated browser origins allowed to call the API (credentials included).
# Unset: same-origin only in production (the API serves the dashboard), any origin in dev.
# Use * to reflect the request Origin. Example: https://novacode.example.com
#CORS_ORIGIN=

# Set to true if Nova Code sits behind a reverse proxy, so login rate limits
# use the real client IP from X-Forwarded-For and session cookies can be Secure.
#TRUST_PROXY=true

# Password login on the sign-in screen (default: true). First-run setup always
# creates a local username/password, even when this is false.
#AUTH_LOCAL_LOGIN=true

# Optional OIDC (Authentik, Authelia, Keycloak, …). Enabled when all three of
# OIDC_ISSUER, OIDC_CLIENT_ID, and OIDC_CLIENT_SECRET are set. The issuer's
# discovery document (/.well-known/openid-configuration) supplies the rest.
# Register https://<your-nova-code-host>/api/auth/oidc/callback as the redirect URI.
#OIDC_ISSUER=https://authentik.example.com/application/o/novacode/
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
# Button label on the login screen (default: SSO)
#OIDC_DISPLAY_NAME=Authentik
# Override if the auto-detected callback URL is wrong behind a proxy
#OIDC_REDIRECT_URI=https://novacode.example.com/api/auth/oidc/callback
# Dashboard origin when it is not the same host as the API (split dev)
#OIDC_APP_URL=https://novacode.example.com
#OIDC_SCOPES=openid profile email

# API log level: fatal | error | warn | info | debug | trace
# Default: info in production, debug otherwise. Stream bodies are never logged.
#LOG_LEVEL=info

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3030

# Max upload size for chat attachments (videos) in MiB, measured on the
# base64-encoded request body (~4/3× the actual file size). Default: 512.
#UPLOAD_BODY_LIMIT_MB=512

# ── File ownership inside containers ─────────────────────────────────────────
# Ensures files written by the container match your host user.
# Run: export UID=$(id -u) GID=$(id -g)  before docker compose up, or set here.
UID=1000
GID=1000
