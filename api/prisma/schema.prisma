generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String             @id
  username            String             @unique
  passwordHash        String             @map("password_hash")
  createdAt           String             @map("created_at")
  gitUserName         String?            @map("git_user_name")
  gitUserEmail        String?            @map("git_user_email")
  theme               String?            @map("theme")
  autoTheme           Boolean            @default(false) @map("auto_theme")
  darkTheme           String?            @map("dark_theme")
  lightTheme          String?            @map("light_theme")
  modelSelection      String             @default("auto") @map("model_selection")
  claudeToken         String?            @map("claude_token")
  claudeAutoContinue  Boolean            @default(false) @map("claude_auto_continue")
  pushSubscriptions   PushSubscription[]
  apiTokens           ApiToken[]

  @@map("users")
}

model ApiToken {
  id          String  @id
  userId      String  @map("user_id")
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  tokenHash   String  @unique @map("token_hash")
  tokenPrefix String  @map("token_prefix")
  createdAt   String  @map("created_at")
  lastUsedAt  String? @map("last_used_at")

  @@index([userId], map: "idx_api_tokens_user_id")
  @@map("api_tokens")
}

model PushSubscription {
  id        String @id
  userId    String @map("user_id")
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String @unique
  p256dh    String
  auth      String
  createdAt String @map("created_at")

  @@map("push_subscriptions")
}

model Workspace {
  id           String        @id
  name         String
  path         String
  group        String?       @map("workspace_group")
  createdAt    String        @map("created_at")
  gitUserName  String?       @map("git_user_name")
  gitUserEmail String?       @map("git_user_email")
  color        String?
  sortOrder    Int?          @map("sort_order")
  defaultAgentType String?    @map("default_agent_type")
  tags           Json?       // string[] stored as JSON
  archived     Boolean       @default(false)
  isFavorite   Boolean       @default(false) @map("is_favorite")
  favoriteOrder Int?         @map("favorite_order")
  sessions     Session[]
  orchestrators Orchestrator[]
  automations  Automation[]

  @@map("workspaces")
}

model Session {
  id          String    @id
  name        String
  tags        Json?     // string[] stored as JSON
  sessionId   String?   @map("session_id")
  agentType   String    @map("agent_type")
  modelSelection String  @default("auto") @map("model_selection")
  sessionMode    String  @default("default") @map("session_mode")
  approvalPolicy String  @default("ask") @map("approval_policy")
  sessionConfigJson String? @map("session_config_json")
  /** Denormalized snippet for session lists (sidebar); updated when chat is saved */
  lastPreviewText String? @map("last_preview_text")
  lastPreviewRole String? @map("last_preview_role")
  lastUsageJson   String? @map("last_usage_json")
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages    SessionMessage[]
  promptQueue SessionPromptQueue[]
  usageTurns  SessionUsage[]
  createdAt   String    @map("created_at")
  updatedAt   String    @default(dbgenerated("CURRENT_TIMESTAMP")) @map("updated_at")
  archived    Boolean   @default(false)
  claudeLimitResetAt String? @map("claude_limit_reset_at")

  @@map("sessions")
}

model SessionMessage {
  id             String  @id
  sessionId      String  @map("session_id")
  session        Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  position       Int
  role           String
  content        String  @default("")
  eventsJson     String? @map("events_json")
  imagePathsJson String? @map("image_paths_json")
  createdAt      String  @map("created_at")

  @@unique([sessionId, position], map: "session_messages_session_id_position_key")
  @@index([sessionId], map: "idx_session_messages_session_id")
  @@map("session_messages")
}

model SessionUsage {
  id           String  @id
  sessionId    String  @map("session_id")
  session      Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  workspaceId  String  @map("workspace_id")
  used         Int
  size         Int
  costAmount   Float?  @map("cost_amount")
  costCurrency String? @map("cost_currency")
  createdAt    String  @map("created_at")

  @@index([sessionId], map: "idx_session_usage_session_id")
  @@index([workspaceId], map: "idx_session_usage_workspace_id")
  @@map("session_usage")
}

model SessionPromptQueue {
  id         String  @id
  sessionId  String  @map("session_id")
  session    Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  text       String
  model      String  @default("auto")
  mode       String  @default("default") @map("session_mode")
  imagePaths String? @map("image_paths_json")
  position   Int
  createdAt  String  @map("created_at")

  @@index([sessionId, position, createdAt], map: "idx_session_prompt_queue_session_position")
  @@map("session_prompt_queue")
}

model Orchestrator {
  id              String    @id
  name            String
  tags            String?
  agentType       String    @default("cursor-agent") @map("agent_type")
  messageJson     String    @map("message_json")
  subtasksJson    String?   @map("subtasks_json")
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt       String    @map("created_at")
  updatedAt       String    @default(dbgenerated("CURRENT_TIMESTAMP")) @map("updated_at")
  archived        Boolean   @default(false)
  runStatus       String?   @map("run_status")
  runCurrentStep  Int?      @map("run_current_step")
  runTotalSteps   Int?      @map("run_total_steps")
  runStartedAt    String?   @map("run_started_at")

  @@map("orchestrators")
}

model RoleTemplate {
  id          String   @id
  name        String   @unique
  description String?
  content     String
  createdAt   String   @map("created_at")
  updatedAt   String   @default(dbgenerated("CURRENT_TIMESTAMP")) @map("updated_at")

  @@map("role_templates")
}

model Automation {
  id              String          @id
  name            String
  workspaceId     String          @map("workspace_id")
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentType       String          @default("cursor-agent") @map("agent_type")
  prompt          String
  intervalMinutes Int             @map("interval_minutes")
  enabled         Boolean         @default(true)
  createdAt       String          @map("created_at")
  updatedAt       String          @default(dbgenerated("CURRENT_TIMESTAMP")) @map("updated_at")
  nextRunAt       String?         @map("next_run_at")
  lastRunAt       String?         @map("last_run_at")
  lastRunStatus   String?         @map("last_run_status")
  lastRunError    String?         @map("last_run_error")
  runs            AutomationRun[]

  @@map("automations")
}

model AutomationRun {
  id           String     @id
  automationId String     @map("automation_id")
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  startedAt    String     @map("started_at")
  finishedAt   String?    @map("finished_at")
  status       String     // "running" | "completed" | "failed"
  agentResponse String?   @map("agent_response")
  changedFiles  String?   @map("changed_files") // json array of { status, file }
  error        String?
  sessionId    String?    @map("session_id")

  @@map("automation_runs")
}
