{
  "ts-node": {
    "files": true
  },
  // Type-checks src (tests included) and the root config files. Builds use tsconfig.build.json.
  "compilerOptions": {
    "module": "nodenext",
    "target": "ES2025",
    "moduleResolution": "nodenext",
    "lib": ["ES2025"],
    "types": ["node"],
    "skipLibCheck": true,
    "sourceMap": true,
    "outDir": "build",
    "resolveJsonModule": true,
    "noImplicitAny": true,
    "strict": true
  },
  "include": ["src", "*.ts"]
}
