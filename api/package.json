{
  "name": "novacode-api",
  "version": "1.0.0",
  "description": "Nova Code backend – Fastify + node-pty",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node build/index.js",
    "generate": "prisma generate",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.99.1",
    "@agentclientprotocol/sdk": "^2.1.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.8",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@fastify/websocket": "^11.3.0",
    "@novacode/shared": "file:../shared",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.10.0",
    "heic-convert": "^2.1.0",
    "jsonwebtoken": "^9.0.3",
    "node-pty": "^1.1.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "prisma": "^7.10.0",
    "strip-ansi": "^7.2.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.20.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "eslint": "^10.13.0",
    "jiti": "^2.7.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  }
}
