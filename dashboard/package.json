    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.10.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.7",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
