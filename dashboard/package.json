    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.21.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "lucide-vue-next": "^1.0.0",
    "marked": "^18.1.2",
    "md-editor-v3": "^7.1.0",
    "mermaid": "^12.0.0",
    "monaco-editor": "^0.57.0",
    "pinia": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
